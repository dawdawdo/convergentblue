---
// Logo: bars of length 1, 1/2, 1/4, ... a geometric series converging to 2.
const { size = 28 } = Astro.props;
const bars = [1, 0.5, 0.25, 0.125, 0.0625];
---
<svg width={size} height={size} viewBox="0 0 28 28" aria-hidden="true">
  <rect x="0" y="0" width="28" height="28" rx="6" fill="var(--ink)" />
  {bars.map((b, i) => <rect x="5" y={5 + i * 4} width={18 * b} height="2.4" rx="1.2" fill="var(--bg)" />)}
</svg>
