---
import type { CollectionEntry } from 'astro:content';
interface Props { projects: CollectionEntry<'projects'>[]; }
const { projects } = Astro.props;
---
<div class="cards">
  {projects.map((p) => (
    <article class="card">
      <span class="meta">{p.data.date.getUTCFullYear()} {p.data.draft && <span class="badge">Draft</span>}</span>
      <h3><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
      <p>{p.data.summary}</p>
      <ul class="tags">{p.data.tags.map((t) => <li><a href={`/tags/${t}/`}>{t}</a></li>)}</ul>
    </article>
  ))}
</div>
