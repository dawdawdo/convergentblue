---
// The divergentblue spiral, redrawn as a golden logarithmic spiral (pole 120,120; radius shrinks by phi each quarter turn).
// The path data is upright; the <g> flips it across the diagonal so it lies landscape, matching the favicon/logo.
// animate:   draws itself inward on load: it converges.
// construct: adds the faint golden-rectangle construction behind it (hero).
// progress:  a dim track plus a copy that draws as the page scrolls (header logo on posts).
interface Props { size?: number | string; animate?: boolean; construct?: boolean; progress?: boolean; class?: string; strokeWidth?: number; }
const { size = 240, animate = false, construct = false, progress = false, class: cls = '', strokeWidth = 7 } = Astro.props;
const d = "M120,20 C94.03,27.95 74.81,45.12 64.66,63.95 C54.51,82.77 53.23,103.03 57.96,119.2 C62.69,135.38 73.18,147.44 84.78,153.89 C96.38,160.34 108.94,161.29 119.01,158.49 C129.08,155.68 136.65,149.27 140.74,142.12 C144.84,134.97 145.53,127.19 143.87,120.92 C142.21,114.65 138.29,109.9 133.89,107.31 C129.49,104.71 124.66,104.22 120.76,105.2 C116.86,106.18 113.88,108.57 112.23,111.28 C110.59,113.99 110.25,116.98 110.82,119.41 C111.4,121.84 112.86,123.71 114.53,124.75 C116.2,125.79 118.05,126.03 119.56,125.69 C121.07,125.35 122.24,124.46 122.9,123.43 C123.56,122.4 123.72,121.26 123.53,120.32 C123.33,119.38 122.78,118.64 122.15,118.23 C121.52,117.81 120.81,117.7 120.22,117.81 C119.64,117.93 119.18,118.26 118.92,118.65 C118.65,119.04 118.58,119.48 118.65,119.84 C118.71,120.21 118.92,120.49 119.15,120.66 C119.39,120.83 119.67,120.88 119.89,120.84 C120.12,120.8 120.3,120.68 120.4,120.53";
const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-width': strokeWidth, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' };
---
<svg class:list={['spiral', cls, { 'spiral-animate': animate }]} width={size} height={size} viewBox="12 45 155 110" aria-hidden="true">
  <g transform="matrix(0 1 1 0 0 0)">
  {construct && <path class="spiral-construct" d="M55.43,15.51 H144.67 V159.91 H55.43 Z M55.43,104.75 H144.67 M110.58,104.75 V159.91 M110.58,125.82 H144.67 M123.6,104.75 V125.82 M110.58,117.78 H123.6 M118.63,117.78 V125.82 M118.63,120.85 H123.6" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />}
  {progress
    ? <Fragment><g class="spiral-track"><path d={d} {...stroke} /></g><path class="spiral-progress" d={d} pathLength="1" {...stroke} /></Fragment>
    : <path class="spiral-line" d={d} pathLength="1" {...stroke} />}
  </g>
</svg>
