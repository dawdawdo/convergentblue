---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import ProjectCards from '../../components/ProjectCards.astro';
import { getPosts, getProjects } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  const projects = await getProjects();
  const tags = new Set([...posts, ...projects].flatMap((e) => e.data.tags));
  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((p) => p.data.tags.includes(tag)),
      projects: projects.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}
const { tag } = Astro.params;
const { posts, projects } = Astro.props;
---
<Base title={`Topic: ${tag}`}>
  <div class="wrap">
    <p class="eyebrow">Tag</p>
    <h1>{tag}</h1>
    {posts.length > 0 && <><h2>Writing</h2><PostList posts={posts} /></>}
    {projects.length > 0 && <><h2>Projects</h2><ProjectCards projects={projects} /></>}
  </div>
</Base>
