---
import Base from '../../layouts/Base.astro';
import PostGrid from '../../components/PostGrid.astro';
import TagNav from '../../components/TagNav.astro';
import { getPosts } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Set(posts.flatMap((e) => e.data.tags));
  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
const title = tag === 'project' ? 'Projects' : tag;
---
<Base title={`Topic: ${title}`}>
  <div class="wide">
    <header class="page-head">
      <p class="eyebrow">Topic</p>
      <h1>{title}</h1>
      <p class="lede">{tag === 'project' ? 'Things I built.' : `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}.`}</p>
      <TagNav current={tag} />
    </header>
    <PostGrid posts={posts} />
  </div>
</Base>
