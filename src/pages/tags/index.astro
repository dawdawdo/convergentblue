---
import Base from '../../layouts/Base.astro';
import { getPosts, getProjects } from '../../lib';
const all = [...(await getPosts()), ...(await getProjects())];
const counts = new Map<string, number>();
for (const e of all) for (const t of e.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base title="Topics">
  <div class="wrap">
    <h1>Topics</h1>
    <ul class="tags" style="gap:0.6rem">
      {tags.map(([t, n]) => <li><a href={`/tags/${t}/`}>{t} · {n}</a></li>)}
    </ul>
  </div>
</Base>
