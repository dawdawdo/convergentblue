---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import { getProjects } from '../../lib';

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const d = project.data;
---
<Base title={d.title} description={d.summary}>
  <article class="wrap">
    <header class="post-header">
      <p class="eyebrow"><a href="/projects/">Projects</a></p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      {d.link && <p><a href={d.link}>{d.link.replace(/^https?:\/\//, '')} →</a></p>}
      <ul class="tags">{d.tags.map((t) => <li><a href={`/tags/${t}/`}>{t}</a></li>)}</ul>
    </header>
    {d.image && <img src={d.image} alt="" />}
    <Toc headings={headings} />
    <div class="prose"><Content /></div>
  </article>
</Base>
