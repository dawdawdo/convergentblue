</header>
<div class="bar"><div class="barin">
  <nav class="tabs" id="tabs" aria-label="Views">
    <a href="#bot">Bot</a>
    <a href="#plan">Plan <small id="tc-plan"></small></a>
    <a href="#chronicle">Chronicle <small id="tc-chron"></small></a>
    <a href="#stash">Stash <small id="tc-stash"></small></a>
    <a href="#cube">Cube</a>
  </nav>
  <script is:inline>
    // mark the open tab at once (the armory script's show() only runs after its data loads); Bot is the default
    (() => { const al = { goals: 'plan', farm: 'plan', inventory: 'stash', ref: 'chronicle' };
      let h = location.hash.slice(1).split('-')[0]; h = al[h] || h;
      if (!['plan', 'chronicle', 'stash', 'cube'].includes(h)) h = 'bot';
      document.querySelectorAll('#tabs a').forEach(a => a.hash === '#' + h && a.setAttribute('aria-current', 'page'));
      document.addEventListener('DOMContentLoaded', () => ['plan', 'chronicle', 'stash', 'cube', 'bot'].forEach(x => {
        const v = document.getElementById('v-' + x); if (v) v.hidden = x !== h; })); })();
  </script>
  <div class="find" role="search">
    <input id="find" type="search" autocomplete="off" placeholder="Find an item, runeword, recipe…" aria-label="Find anything" aria-controls="results" aria-expanded="false">
