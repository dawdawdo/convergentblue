/* ---------- events ---------- */
document.addEventListener('click', e => {
  const sm = e.target.closest('details.goal>summary'); if (sm) store.set('open:' + sm.parentElement.dataset.g, !sm.parentElement.open);
  const cs = e.target.closest('details.csec>summary'); if (cs) store.set('cube:' + cs.parentElement.dataset.c, !cs.parentElement.open);
  if (e.target.id === 'cubeall' || e.target.id === 'cubenone') { setCube(e.target.id === 'cubeall'); return; }
  const gs = e.target.closest('details.ig>summary'); if (gs) { const g = gs.parentElement.dataset.grp; gs.parentElement.open ? OPENG.delete(g) : OPENG.add(g); store.set('openg', [...OPENG]); }
  const t = e.target.closest('button, a, .it, input');
  if (!t) return;
  if (t.matches('#chP .chip')) { state.ch = t.dataset.ch; saveState(); renderPlan(); }
  else if (t.matches('#mode button')) { state.mode = t.dataset.mode; saveState(); renderPlan(); }
  else if (t.matches('#rwmode button')) { state.rwmode = t.dataset.rw; saveState(); renderChron(); }
  else if (t.matches('#hk .chip')) { state.ist = state.ist === t.dataset.st ? null : t.dataset.st; renderStash(); }
  else if (t.matches('#iqual button')) { state.iqual = t.dataset.q; renderStash(); }
  else if (t.id === 'clearf') { Object.assign(state, { ch: 'all', iqual: 'all', ist: null, iq: '' }); $('#iq').value = ''; renderStash(); }
  else if (t.id === 'dismiss') { store.set('seen', D.snap); renderNews(); }
  else if (t.matches('[data-shownew]')) { e.preventDefault(); Object.assign(state, { ch: 'all', iqual: 'all', ist: 'new', iq: '' }); $('#iq').value = ''; go('stash'); renderStash(); window.scrollTo({ top: $('#hk').getBoundingClientRect().top + scrollY - 90 }); }
  else if (t.matches('.results button')) pick(+t.dataset.j);
  else if (t.matches('[data-farm]')) { const f = RAILMAP[t.dataset.farm]; if (f) { state.mode = 'farm'; saveState(); renderPlan(); const el = $(`#st-${f.g.id}-${f.s.id}`); if (el) { const h = $('details.how', el); if (h) h.open = true; flash(el); } } }
  else if (t.matches('[data-rwready]')) { state.rwmode = 'ready'; saveState(); renderChron(); }
  else if (t.id === 'freshbtn') { const p = $('#freshpop'); p.hidden = !p.hidden; t.setAttribute('aria-expanded', String(!p.hidden)); }
  else if (t.matches('.it') && !getSelection().toString()) { t.classList.toggle('open'); t.setAttribute('aria-expanded', t.classList.contains('open')); }
});
document.addEventListener('change', e => {
  const cb = e.target.closest('.step input[data-k]'); if (!cb || !isOwner()) return;
  const t = store.get('ticks', {}); t[cb.dataset.k] = cb.checked; store.set('ticks', t); renderPlan(); IDX = null;
});

// Bot tab "Current gear": the bot character's worn items (pagedata items with a slot, from the armory scan) and
// the stat totals d2r-bot's bot/gear.py adds as D.gear. Updates when a bot session starts (it backs up the save).
const SLOTS = [['Head', 'Helm'], ['Neck', 'Amulet'], ['Torso', 'Armor'], ['RightArm', 'Right hand'], ['LeftArm', 'Left hand'],
  ['Gloves', 'Gloves'], ['Belt', 'Belt'], ['Feet', 'Boots'], ['RightRing', 'Ring'], ['LeftRing', 'Ring'],
  ['RightHand', 'Swap right'], ['LeftHand', 'Swap left']];
function renderGear() {
  const box = document.getElementById('gear'); if (!box) return;
  const G = D.gear, who = (G && G.char) || 'Blizzaga';
  const at = D.snap ? new Date(D.snap).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
  document.getElementById('gearsub').textContent = `${who}${G ? `, level ${G.level}` : ''}${at ? ` · save of ${at}` : ''}`;
  const qc = i => i.rw ? 'q-rw' : 'q-' + i.q;
  const row = (label, i, sub) => `<details><summary><span class="sl">${esc(label)}</span><span><b class="${qc(i)}">${esc(i.n)}</b>` +
    ` <span class="gb">${esc(sub ?? (i.b + (i.e ? ' · ethereal' : '') + (i.s && i.s.length ? ' · ' + i.s.join(' ') : '')))}</span></span></summary>` +
    `<ul>${(i.st || []).map(x => `<li>${esc(x)}</li>`).join('')}</ul></details>`;
  const list = (title, loc) => {
    const worn = D.items.filter(i => i.l === loc && i.eq);
    const rows = SLOTS.map(([k, label]) => worn.filter(i => i.sl === k).map(i => row(label, i)).join('')).join('') +
      worn.filter(i => !SLOTS.some(([k]) => k === i.sl)).map(i => row(i.sl || 'Worn', i)).join('');
    return rows ? `<div class="panel gitems"><h3>${esc(title)}</h3>${rows}</div>` : '';
  };
  const charms = D.items.filter(i => i.l === who + ':inventory' && /cha$/.test(i.ty));
  const charmBox = charms.length ? `<div class="panel gitems"><h3>Charms in the inventory</h3>${charms.map(i => row(i.b.replace(' Charm', ''), i, (i.st || []).slice(0, 2).join(' · '))).join('')}</div>` : '';
  const stats = G ? `<div class="gstats">${G.groups.filter(g => g.rows.length).map(g => `<div class="panel gcard"><h3>${esc(g.name)}</h3><table>` +
    g.rows.map(([k, v, n]) => `<tr><td>${esc(k)}${n ? `<div class="nt">${esc(n)}</div>` : ''}</td><td class="v">${esc(v)}</td></tr>`).join('') +
    `</table>${g.note ? `<p class="cn">${esc(g.note)}</p>` : ''}</div>`).join('')}</div><p class="gnote">${esc(G.note)} ` +
    `Updates when a bot session starts (that's when the save is backed up and scanned).</p>` : '<p class="gnote">No stat totals in this scan yet.</p>';
  box.innerHTML = stats + list(who, who + ':equipped') + charmBox + list('Mercenary', who + ' merc:equipped');
}

window.addEventListener('bot-owner', () => { try { renderPlan(); IDX = null; } catch (e) { /* armory data not loaded yet */ } });

document.addEventListener('keydown', e => {
  const f = $('#find');
  if (e.key === '/' && document.activeElement !== f && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) { e.preventDefault(); f.focus(); f.select(); return; }
  if (document.activeElement === f && !$('#results').hidden) {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); sel = Math.max(0, Math.min(hits.length - 1, sel + (e.key === 'ArrowDown' ? 1 : -1)));
      $$('#results button').forEach(b => b.setAttribute('aria-selected', String(+b.dataset.j === sel))); const b = $(`#results button[data-j="${sel}"]`); if (b) b.scrollIntoView({ block: 'nearest' }); }
    else if (e.key === 'Enter') { e.preventDefault(); pick(sel); }
  }
  if (e.key === 'Escape') { $('#results').hidden = true; $('#freshpop').hidden = true; if (document.activeElement === f) { f.value = ''; f.blur(); } }
  if ((e.key === 'Enter' || e.key === ' ') && document.activeElement.matches('.it')) { e.preventDefault(); document.activeElement.click(); }
});
$('#find').addEventListener('input', runFind);
$('#find').addEventListener('focus', () => { if ($('#find').value) runFind(); });
document.addEventListener('pointerdown', e => { if (!e.target.closest('.find')) $('#results').hidden = true; if (!e.target.closest('.fresh')) { $('#freshpop').hidden = true; $('#freshbtn').setAttribute('aria-expanded', 'false'); } });
let tc; $('#cq').addEventListener('input', e => { clearTimeout(tc); tc = setTimeout(() => { state.cq = e.target.value.trim(); renderChron(); }, 120); });
let tq; $('#iq').addEventListener('input', e => { clearTimeout(tq); tq = setTimeout(() => { state.iq = e.target.value.trim(); renderStash(); }, 120); });
addEventListener('hashchange', show); addEventListener('popstate', show);

renderFresh(); renderNews(); renderLedger(); renderCube(); initCubeFolds(); renderChron(); renderPlan(); renderStash(); renderGear(); show();

})();
</script>
<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);
  const KEY = 'botDashToken';
  const store = {
    get() { try { return localStorage.getItem(KEY) || ''; } catch { return ''; } },
    set(v) { try { v ? localStorage.setItem(KEY, v) : localStorage.removeItem(KEY); } catch {} },
  };
  let token = store.get();
  let task = 'meph';
  let taskTouched = false;
  let last = null;
  let owner = false;
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const TASK_NAME = { meph: 'Mephisto', lk: 'Lower Kurast', tunnels: 'Ancient Tunnels', pit: 'The Pit', 'lk,meph': 'LK + Meph', 'lk+meph': 'LK + Meph' };  // the combo: old runs only
  const ago = (ms) => {
    const s = Math.max(0, Math.round(ms / 1000));
    if (s < 90) return `${s} s`;
    if (s < 5400) return `${Math.round(s / 60)} min`;
    if (s < 172800) return `${(s / 3600).toFixed(1)} h`;
    return `${Math.round(s / 86400)} days`;
  };
  const hhmm = (start) => String(start).slice(11, 16);
  const when = (ts) => new Date(ts).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  const runTime = (r) => new Date(String(r.start).replace(' ', 'T')).getTime();  // the bot's local time = viewer's

  async function api(path, body) {
    const r = await fetch(`/api/bot/${path}`, {
      method: body ? 'POST' : 'GET',
      headers: { ...(token ? { authorization: `Bearer ${token}` } : {}), ...(body ? { 'content-type': 'application/json' } : {}) },
      body: body ? JSON.stringify(body) : undefined, cache: 'no-store',
    });
    const j = await r.json().catch(() => ({}));
    if (r.status === 401) { token = ''; store.set(''); setOwner(false); showLogin('Wrong password.'); throw new Error('401'); }
    if (!r.ok) throw new Error(j.error || `HTTP ${r.status}`);
    return j;
  }

  function showLogin(msg) {
    $('loginform').hidden = false;
    $('loginmsg').hidden = !msg; $('loginmsg').textContent = msg || '';
    $('pw').focus();
  }
  function setOwner(on) {
    owner = on;
    document.querySelector('.now').classList.toggle('locked', !on);
    for (const b of document.querySelectorAll('#tasks button, .btns button')) b.disabled = !on;
    $('ownernote').hidden = on; $('logout').hidden = !on;
    if (on) { $('loginform').hidden = true; $('loginmsg').hidden = true; }
    const was = window.botOwner === true; window.botOwner = on;
    if (was !== on) window.dispatchEvent(new Event('bot-owner'));  // the Plan tab's checkboxes unlock / lock
  }
  $('signin').addEventListener('click', () => showLogin());

  $('loginform').addEventListener('submit', (e) => {
    e.preventDefault();
    token = $('pw').value.trim();
    if (!token) return;
    store.set(token);
    $('pw').value = '';
    refresh();
  });
  $('logout').addEventListener('click', () => { store.set(''); token = ''; setOwner(false); });

  for (const b of $('tasks').querySelectorAll('button')) {
    b.addEventListener('click', () => { task = b.dataset.t; taskTouched = true; paintTasks(); });
  }
  function paintTasks() {
    for (const b of $('tasks').querySelectorAll('button')) b.setAttribute('aria-pressed', String(b.dataset.t === task));
  }

  async function send(body, label) {
    for (const id of ['start', 'stopafter', 'stopnow']) $(id).disabled = true;
    try { await api('control', body); taskTouched = false; await refresh(); }
    catch (e) { if (e.message !== '401') alert(`${label} failed: ${e.message}`); }
    finally { setOwner(owner); }
  }
  $('start').addEventListener('click', () => send({ desired: { run: true, tasks: task } }, 'Start'));
  $('stopafter').addEventListener('click', () => send({ command: 'stop_after_run' }, 'Stop'));
  $('stopnow').addEventListener('click', () => {
    if (confirm('Stop the bot right away, mid-run? She is left wherever she is; the next start recovers the game.'))
      send({ command: 'stop_now' }, 'Stop');
  });

  function describe(s, now) {
    if (!s) return { cls: 's-off', word: 'Never checked in', facts: 'The bot has not reported to this site yet.' };
    const age = now - s.received;
    const sup = s.supervisor || {}, bot = s.bot || {}, want = s.desired || {};
    if (age > 120e3) return { cls: 's-off', word: 'Offline', facts: `Last heard from ${esc(s.machine)} ${ago(age)} ago.` };
    const running = bot.state === 'running' && sup.pid;
    const bits = [];
    // magic find read from the save at session start (bot/mf.py); a boss task below its minimum runs as LK
    const mf = bot.mf, low = (mf && mf.low) || [];
    const mfWarn = low.length ? `<br><b class="mf-low">${low.map(n => esc(TASK_NAME[n] || n)).join(', ')} skipped:</b> ` +
      `magic find ${esc(mf.mf)}% is below ${low.map(n => `${esc(mf.min[n])}%`).join(', ')}. Running LK until the MF gear is on ` +
      `(checked when the next session starts).` : '';
    if (running) {
      bits.push(`Run <b>${esc(bot.run)}</b> of ${esc(bot.runs)}`, `task <b>${esc(TASK_NAME[bot.task] || bot.task)}</b>`);
      if (mf) bits.push(`magic find <b>${esc(mf.mf)}%</b>`);
      if (bot.started) bits.push(`session ${ago(now - bot.started * 1000)}`);
      if (!want.run) return { cls: 's-wait', word: 'Stopping after this run', facts: bits.join(' · ') + mfWarn };
      return { cls: 's-run', word: 'Running', facts: bits.join(' · ') + mfWarn };
    }
    if (sup.state === 'backoff') {
      return { cls: 's-wait', word: 'Waiting to retry',
               facts: `${esc(sup.last_end || '')}; next try ${when(sup.backoff_until * 1000)}.` };
    }
    if (want.run) return { cls: 's-wait', word: 'Starting', facts: esc(sup.state || '') };
    const by = want.stopped_by === 'F12' ? 'F12 (or a hand on the mouse) stopped it' : want.set_by === 'remote' ? 'stopped from here' : 'stopped';
    return { cls: 's-stop', word: 'Stopped', facts: `${by}${sup.last_end ? ` · last session ${esc(sup.last_end)}` : ''}.` };
  }

  function paint(st) {
    const now = st.now, s = st.snapshot;
    const d = describe(s, now);
    $('state').className = `state ${d.cls}`;
    $('state').querySelector('span').textContent = d.word;
    $('facts').innerHTML = d.facts;
    if (s) {
      const age = now - s.received;
      $('pill').hidden = false;
      $('pill').classList.toggle('stale', age > 120e3);
      $('pilltxt').innerHTML = age > 120e3 ? `<b>Offline</b> · ${ago(age)}` : `${esc(s.machine)} · checked in ${ago(age)} ago`;
      if (!taskTouched && s.desired && TASK_NAME[s.desired.tasks]) task = s.desired.tasks;
    }
    paintTasks();
    const q = st.pending, dl = st.delivered;
    const say = (p) => [p.desired ? (p.desired.run ? `start ${TASK_NAME[p.desired.tasks] || ''}` : 'stop') : '',
                        p.command ? p.command.replace(/_/g, ' ') : ''].filter(Boolean).join(', ');
    if (q) { $('queued').hidden = false; $('queued').textContent = `Queued at ${when(q.queued)}: ${say(q)}. The bot picks it up at its next check-in (every 30 s).`; }
    else if (dl && now - dl.delivered < 600e3) { $('queued').hidden = false; $('queued').textContent = `Sent to the bot at ${when(dl.delivered)}: ${say(dl)}.`; }
    else $('queued').hidden = true;

    const runs = st.runs || [];
    const day = runs.filter((r) => now - runTime(r) < 86400e3);
    const recent = runs.filter((r) => now - runTime(r) < 3 * 3600e3);
    const by = (rs, t) => rs.filter((r) => r.task === t);
    const pct = (a, b) => (b ? `${Math.round((100 * a) / b)}%` : '–');
    const meph = by(day, 'meph'), lk = by(day, 'lk');
    const okM = meph.filter((r) => r.result === 'ok').length;
    const chickens = day.filter((r) => r.result === 'chicken').length, fails = day.filter((r) => r.result === 'fail').length;
    const hours = recent.length ? Math.max(0.25, (now - Math.min(...recent.map(runTime))) / 3600e3) : 0;
    const chestsLk = lk.reduce((a, r) => a + (r.chests || 0), 0);
    $('statsub').textContent = `${day.length} runs`;
    $('botmeters').innerHTML = [
      ['Runs per hour', recent.length ? (recent.length / hours).toFixed(1) : '–', 'last 3 hours'],
      ['Mephisto ok', pct(okM, meph.length), `${okM} of ${meph.length} runs`],
      ['Chickens · fails', `${chickens} · ${fails}`, 'chicken = saved out on low life'],
      ['LK chests a run', lk.length ? (chestsLk / lk.length).toFixed(1) : '–', `${lk.length} LK runs`],
    ].map(([k, v, dd]) => `<div class="panel mt"><div class="k">${k}</div><div class="v">${v}</div><div class="d">${dd}</div></div>`).join('');

    const counts = {};
    for (const r of day) for (const w of String(r.picked || '').split(/\s+/).filter(Boolean)) counts[w] = (counts[w] || 0) + 1;
    const common = new Set(['gem', 'key', 'rejuv', 'rejuv_spare', 'gold', 'potion']);
    const loot = Object.entries(counts).sort((a, b) => (common.has(a[0]) - common.has(b[0])) || b[1] - a[1]);
    $('loot').innerHTML = loot.length
      ? loot.map(([w, n]) => `<span class="lc${common.has(w) ? '' : ' rare'}">${esc(w.replace(/_/g, ' '))} <b>×${n}</b></span>`).join('')
      : '<span class="muted">Nothing picked up in the last 24 hours.</span>';

    $('runs').innerHTML = runs.slice(0, 40).map((r) => {
      const res = r.result || '?';
      return `<tr><td class="t">${esc(String(r.start).slice(5, 10))} ${esc(hhmm(r.start))}</td><td>${esc(TASK_NAME[r.task] || r.task)}</td>`
        + `<td><span class="tag r-${esc(res)}"><i></i>${esc(res)}</span>${r.error ? `<div class="err">${esc(r.error)}</div>` : ''}</td>`
        + `<td class="n">${Math.round(r.duration || 0)} s</td><td class="n">${r.chests || ''}</td><td>${esc(String(r.picked || '').replace(/_/g, ' '))}</td></tr>`;
    }).join('') || '<tr><td colspan="6" class="muted">No runs yet.</td></tr>';
    $('foottxt').textContent = `Updated ${when(now)} · refreshes every 15 s`;
  }

  async function refresh() {
    try {
      last = await api('state');
      setOwner(!!last.owner);
      $('botfoot').hidden = false;
      paint(last);
    } catch (e) {
      if (e.message !== '401') { $('botfoot').hidden = false; $('foottxt').textContent = `Couldn't load the bot's state: ${e.message}`; }
    }
  }
  // only while the Bot tab is open: each refresh reads the Durable Object (free plan: 5M rows read a day)
  // Bot is the default tab: no hash (or an unknown one) counts as Bot, like show() in the armory script
  const ARMORY = ['plan', 'chronicle', 'stash', 'cube', 'goals', 'farm', 'inventory', 'ref'];
  const onTab = () => !ARMORY.includes(location.hash.slice(1).split('-')[0]);
  setOwner(false);
  if (onTab()) refresh();
  setInterval(() => { if (!document.hidden && onTab()) refresh(); }, 15000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden && onTab()) refresh(); });
  addEventListener('hashchange', () => { if (onTab()) refresh(); });
})();
</script>
