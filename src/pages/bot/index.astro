---
// Private console for Stephen's D2R bot (GLaDOS). Data and control go through worker/bot.js; the password is the
// DASH_TOKEN secret, kept in this browser's localStorage. Site layout and theme; all styles live under .bot.
// Not linked anywhere, noindex, left out of the sitemap (astro.config.mjs).
import Base from '../../layouts/Base.astro';
---
<Base title="Blizzaga's Bot" description="Remote console for a D2R bot." noindex>
<style is:global>
.bot { --ok: #23722a; --bad: #b02a2a; font: 1rem/1.5 var(--sans); }
@media (prefers-color-scheme: dark) { .bot { --ok: #7fd08a; --bad: #ff8a80; } }
.bot button, .bot input { font: inherit; color: inherit; }
.bot :focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
.bot .page-top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0.75rem 1.5rem; margin: 0.5rem 0 1.75rem; }
.bot .page-top h1 { margin: 0; }
.bot .page-top .eyebrow { margin: 0 0 0.6rem; }
.bot .pill { display: inline-flex; align-items: center; gap: 0.5rem; border: 1px solid var(--rule); background: var(--surface); border-radius: 999px; padding: 0.4rem 0.9rem; font-size: 0.9rem; color: var(--muted); }
.bot .pill .dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--ok); flex: none; }
.bot .pill.stale .dot { background: transparent; border: 2px solid var(--bad); }
.bot .pill.stale b { color: var(--bad); }
.bot h2 { display: flex; align-items: baseline; gap: 0.75rem; margin: 2.5rem 0 0.9rem; }
.bot h2 small { font: 400 0.9rem var(--sans); color: var(--muted); }
.bot .panel { background: var(--surface); border: 1px solid var(--rule); border-radius: 10px; }
.bot .muted { color: var(--muted); }
/* now */
.bot .now { padding: 1.25rem 1.4rem; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem 1.5rem; align-items: start; }
.bot .state { font: 700 1.75rem/1.15 var(--sans); letter-spacing: -0.01em; display: flex; align-items: center; gap: 0.75rem; }
.bot .state i { width: 0.85rem; height: 0.85rem; border-radius: 50%; flex: none; display: inline-block; }
.bot .s-run { color: var(--ok); } .bot .s-run i { background: var(--ok); }
.bot .s-stop i { border: 2.5px solid var(--ink); border-radius: 2px; }
.bot .s-wait i { border: 2.5px dashed var(--ink); }
.bot .s-off { color: var(--bad); }
.bot .s-off i, .bot .r-fail i { background: var(--bad); border-radius: 0; clip-path: polygon(20% 0,50% 30%,80% 0,100% 20%,70% 50%,100% 80%,80% 100%,50% 70%,20% 100%,0 80%,30% 50%,0 20%); }
.bot .facts { margin: 0.5rem 0 0; color: var(--muted); }
.bot .facts b { color: var(--ink); font-weight: 600; }
.bot .queued { margin: 0.75rem 0 0; padding: 0.5rem 0.75rem; border-radius: 6px; background: var(--code-bg); font-size: 0.92rem; }
.bot .ctl { display: grid; gap: 0.7rem; justify-items: end; }
.bot .seg { display: inline-flex; flex-wrap: wrap; gap: 2px; border: 1px solid var(--rule); border-radius: 999px; background: var(--bg); padding: 3px; }
.bot .seg button { border: 0; background: none; border-radius: 999px; padding: 0.4rem 0.9rem; min-height: 2.1rem; cursor: pointer; font-size: 0.92rem; color: var(--muted); white-space: nowrap; }
.bot .seg button:hover { color: var(--ink); }
.bot .seg button[aria-pressed="true"] { background: var(--ink); color: var(--bg); }
.bot .btns { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: flex-end; }
.bot .btn { min-height: 2.5rem; padding: 0.45rem 1rem; border-radius: 6px; border: 1px solid var(--rule); background: var(--surface); cursor: pointer; font-weight: 600; font-size: 0.95rem; }
.bot .btn:hover { border-color: var(--ink); }
.bot .btn.go { background: var(--ink); border-color: var(--ink); color: var(--bg); }
.bot .btn.go:hover { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.bot .btn.danger { color: var(--bad); border-color: currentColor; }
.bot .btn:disabled { opacity: 0.5; cursor: default; }
@media (max-width: 720px) { .bot .now { grid-template-columns: 1fr; } .bot .ctl { justify-items: start; } .bot .btns { justify-content: flex-start; } }
/* tiles */
.bot .meters { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem; }
.bot .mt { padding: 0.9rem 1.1rem; }
.bot .mt .k { font: 600 0.75rem/1.3 var(--sans); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
.bot .mt .v { font-size: 1.9rem; font-weight: 700; line-height: 1.15; margin: 0.3rem 0 0.15rem; font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
.bot .mt .d { color: var(--muted); font-size: 0.9rem; }
/* loot */
.bot .loot { padding: 0.9rem 1rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
.bot .lc { display: inline-flex; align-items: baseline; gap: 0.35rem; border: 1px solid var(--rule); border-radius: 999px; padding: 0.2rem 0.65rem; font: 0.8rem/1.4 var(--mono); color: var(--muted); }
.bot .lc.rare { border-color: var(--ink); color: var(--ink); font-weight: 600; }
/* runs */
.bot .tbl { overflow-x: auto; border: 1px solid var(--rule); border-radius: 10px; background: var(--surface); }
.bot .tbl table { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
.bot .tbl th, .bot .tbl td { text-align: left; padding: 0.5rem 0.9rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
.bot .tbl th { font: 600 0.72rem/1.3 var(--sans); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); background: var(--code-bg); }
.bot .tbl tr:last-child td { border-bottom: 0; }
.bot .tbl td.n { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.bot .tbl td.t { white-space: nowrap; font: 0.85rem/1.6 var(--mono); color: var(--muted); }
.bot .tag { display: inline-flex; align-items: center; gap: 0.45rem; font-weight: 600; white-space: nowrap; }
.bot .tag i { width: 0.6rem; height: 0.6rem; border-radius: 50%; flex: none; display: inline-block; }
.bot .r-ok { color: var(--ok); } .bot .r-ok i { background: currentColor; }
.bot .r-chicken i { border: 2px solid currentColor; }
.bot .r-fail { color: var(--bad); }
.bot .err { color: var(--muted); font-size: 0.85rem; }
/* login */
.bot .login { max-width: 26rem; padding: 1.25rem 1.4rem; margin: 2rem 0; }
.bot .login h2 { margin: 0 0 0.75rem; }
.bot .login form { display: flex; gap: 0.5rem; }
.bot .login input { flex: 1; min-width: 0; height: 2.6rem; border: 1px solid var(--rule); border-radius: 6px; background: var(--bg); padding: 0 0.75rem; }
.bot .msg { color: var(--bad); margin: 0.6rem 0 0; }
.bot .foot { margin-top: 2.5rem; color: var(--muted); font-size: 0.85rem; display: flex; gap: 1rem; flex-wrap: wrap; }
.bot .foot button { border: 0; background: none; color: var(--accent); cursor: pointer; padding: 0; font-size: 0.85rem; text-decoration: underline; text-underline-offset: 0.18em; }
</style>
<div class="wide bot">
<header class="page-top">
  <div><p class="eyebrow" id="sub">D2R offline · remote console</p><h1>Blizzaga's Bot</h1></div>
  <div class="pill" id="pill" hidden><span class="dot"></span><span id="pilltxt"></span></div>
</header>

<section class="panel login" id="login" hidden>
  <h2>Password</h2>
  <form id="loginform"><input id="pw" type="password" autocomplete="current-password" aria-label="Password"><button class="btn go">Open</button></form>
  <p class="msg" id="loginmsg" hidden></p>
</section>

<div id="main" hidden>
  <section class="panel now">
    <div>
      <div class="state" id="state"><i></i><span></span></div>
      <p class="facts" id="facts"></p>
      <p class="queued" id="queued" hidden></p>
    </div>
    <div class="ctl">
      <div class="seg" id="tasks" aria-label="What to run">
        <button data-t="meph">Mephisto</button><button data-t="lk">Lower Kurast</button><button data-t="lk,meph">LK + Meph</button>
      </div>
      <div class="btns">
        <button class="btn go" id="start">Start</button>
        <button class="btn" id="stopafter">Stop after this run</button>
        <button class="btn danger" id="stopnow">Stop now</button>
      </div>
    </div>
  </section>

  <h2>Last 24 hours <small id="statsub"></small></h2>
  <div class="meters" id="meters"></div>

  <h2>Loot <small>last 24 hours</small></h2>
  <div class="panel loot" id="loot"></div>

  <h2>Recent runs</h2>
  <div class="tbl"><table><thead><tr><th>Started</th><th>Task</th><th>Result</th><th style="text-align:right">Time</th><th style="text-align:right">Chests</th><th>Picked up</th></tr></thead><tbody id="runs"></tbody></table></div>
</div>
<div class="foot" id="foot" hidden><span id="foottxt"></span><button id="logout">Forget password on this device</button></div>
</div>

<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);
  const KEY = 'botDashToken';
  const store = {
    get() { try { return localStorage.getItem(KEY) || ''; } catch { return ''; } },
    set(v) { try { v ? localStorage.setItem(KEY, v) : localStorage.removeItem(KEY); } catch {} },
  };
  let token = store.get();
  let task = 'meph';
  let taskTouched = false;
  let last = null;
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const TASK_NAME = { meph: 'Mephisto', lk: 'Lower Kurast', 'lk,meph': 'LK + Meph' };
  const ago = (ms) => {
    const s = Math.max(0, Math.round(ms / 1000));
    if (s < 90) return `${s} s`;
    if (s < 5400) return `${Math.round(s / 60)} min`;
    if (s < 172800) return `${(s / 3600).toFixed(1)} h`;
    return `${Math.round(s / 86400)} days`;
  };
  const hhmm = (start) => String(start).slice(11, 16);
  const when = (ts) => new Date(ts).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  const runTime = (r) => new Date(String(r.start).replace(' ', 'T')).getTime();  // the bot's local time = viewer's

  async function api(path, body) {
    const r = await fetch(`/api/bot/${path}`, {
      method: body ? 'POST' : 'GET',
      headers: { authorization: `Bearer ${token}`, ...(body ? { 'content-type': 'application/json' } : {}) },
      body: body ? JSON.stringify(body) : undefined, cache: 'no-store',
    });
    const j = await r.json().catch(() => ({}));
    if (r.status === 401) { showLogin('Wrong password.'); throw new Error('401'); }
    if (!r.ok) throw new Error(j.error || `HTTP ${r.status}`);
    return j;
  }

  function showLogin(msg) {
    $('main').hidden = true; $('foot').hidden = true; $('pill').hidden = true; $('login').hidden = false;
    $('loginmsg').hidden = !msg; $('loginmsg').textContent = msg || '';
    $('pw').focus();
  }

  $('loginform').addEventListener('submit', (e) => {
    e.preventDefault();
    token = $('pw').value.trim();
    if (!token) return;
    store.set(token);
    $('pw').value = '';
    refresh();
  });
  $('logout').addEventListener('click', () => { store.set(''); token = ''; showLogin(); });

  for (const b of $('tasks').querySelectorAll('button')) {
    b.addEventListener('click', () => { task = b.dataset.t; taskTouched = true; paintTasks(); });
  }
  function paintTasks() {
    for (const b of $('tasks').querySelectorAll('button')) b.setAttribute('aria-pressed', String(b.dataset.t === task));
  }

  async function send(body, label) {
    for (const id of ['start', 'stopafter', 'stopnow']) $(id).disabled = true;
    try { await api('control', body); taskTouched = false; await refresh(); }
    catch (e) { if (e.message !== '401') alert(`${label} failed: ${e.message}`); }
    finally { for (const id of ['start', 'stopafter', 'stopnow']) $(id).disabled = false; }
  }
  $('start').addEventListener('click', () => send({ desired: { run: true, tasks: task } }, 'Start'));
  $('stopafter').addEventListener('click', () => send({ command: 'stop_after_run' }, 'Stop'));
  $('stopnow').addEventListener('click', () => {
    if (confirm('Stop the bot right away, mid-run? She is left wherever she is; the next start recovers the game.'))
      send({ command: 'stop_now' }, 'Stop');
  });

  function describe(s, now) {
    if (!s) return { cls: 's-off', word: 'Never checked in', facts: 'The bot has not reported to this site yet.' };
    const age = now - s.received;
    const sup = s.supervisor || {}, bot = s.bot || {}, want = s.desired || {};
    if (age > 120e3) return { cls: 's-off', word: 'Offline', facts: `Last heard from ${esc(s.machine)} ${ago(age)} ago.` };
    const running = bot.state === 'running' && sup.pid;
    const bits = [];
    if (running) {
      bits.push(`Run <b>${esc(bot.run)}</b> of ${esc(bot.runs)}`, `task <b>${esc(TASK_NAME[bot.task] || bot.task)}</b>`);
      if (bot.started) bits.push(`session ${ago(now - bot.started * 1000)}`);
      if (!want.run) return { cls: 's-wait', word: 'Stopping after this run', facts: bits.join(' · ') };
      return { cls: 's-run', word: 'Running', facts: bits.join(' · ') };
    }
    if (sup.state === 'backoff') {
      return { cls: 's-wait', word: 'Waiting to retry',
               facts: `${esc(sup.last_end || '')}; next try ${when(sup.backoff_until * 1000)}.` };
    }
    if (want.run) return { cls: 's-wait', word: 'Starting', facts: esc(sup.state || '') };
    const by = want.stopped_by === 'F12' ? 'F12 (or a hand on the mouse) stopped it' : want.set_by === 'remote' ? 'stopped from here' : 'stopped';
    return { cls: 's-stop', word: 'Stopped', facts: `${by}${sup.last_end ? ` · last session ${esc(sup.last_end)}` : ''}.` };
  }

  function paint(st) {
    const now = st.now, s = st.snapshot;
    const d = describe(s, now);
    $('state').className = `state ${d.cls}`;
    $('state').querySelector('span').textContent = d.word;
    $('facts').innerHTML = d.facts;
    if (s) {
      const age = now - s.received;
      $('pill').hidden = false;
      $('pill').classList.toggle('stale', age > 120e3);
      $('pilltxt').innerHTML = age > 120e3 ? `<b>Offline</b> · ${ago(age)}` : `${esc(s.machine)} · checked in ${ago(age)} ago`;
      if (!taskTouched && s.desired && TASK_NAME[s.desired.tasks]) task = s.desired.tasks;
    }
    paintTasks();
    const q = st.pending, dl = st.delivered;
    const say = (p) => [p.desired ? (p.desired.run ? `start ${TASK_NAME[p.desired.tasks] || ''}` : 'stop') : '',
                        p.command ? p.command.replace(/_/g, ' ') : ''].filter(Boolean).join(', ');
    if (q) { $('queued').hidden = false; $('queued').textContent = `Queued at ${when(q.queued)}: ${say(q)}. The bot picks it up at its next check-in (every 30 s).`; }
    else if (dl && now - dl.delivered < 600e3) { $('queued').hidden = false; $('queued').textContent = `Sent to the bot at ${when(dl.delivered)}: ${say(dl)}.`; }
    else $('queued').hidden = true;

    const runs = st.runs || [];
    const day = runs.filter((r) => now - runTime(r) < 86400e3);
    const recent = runs.filter((r) => now - runTime(r) < 3 * 3600e3);
    const by = (rs, t) => rs.filter((r) => r.task === t);
    const pct = (a, b) => (b ? `${Math.round((100 * a) / b)}%` : '–');
    const meph = by(day, 'meph'), lk = by(day, 'lk');
    const okM = meph.filter((r) => r.result === 'ok').length;
    const chickens = day.filter((r) => r.result === 'chicken').length, fails = day.filter((r) => r.result === 'fail').length;
    const hours = recent.length ? Math.max(0.25, (now - Math.min(...recent.map(runTime))) / 3600e3) : 0;
    const chestsLk = lk.reduce((a, r) => a + (r.chests || 0), 0);
    $('statsub').textContent = `${day.length} runs`;
    $('meters').innerHTML = [
      ['Runs per hour', recent.length ? (recent.length / hours).toFixed(1) : '–', 'last 3 hours'],
      ['Mephisto ok', pct(okM, meph.length), `${okM} of ${meph.length} runs`],
      ['Chickens · fails', `${chickens} · ${fails}`, 'chicken = saved out on low life'],
      ['LK chests a run', lk.length ? (chestsLk / lk.length).toFixed(1) : '–', `${lk.length} LK runs`],
    ].map(([k, v, dd]) => `<div class="panel mt"><div class="k">${k}</div><div class="v">${v}</div><div class="d">${dd}</div></div>`).join('');

    const counts = {};
    for (const r of day) for (const w of String(r.picked || '').split(/\s+/).filter(Boolean)) counts[w] = (counts[w] || 0) + 1;
    const common = new Set(['gem', 'key', 'rejuv', 'rejuv_spare', 'gold', 'potion']);
    const loot = Object.entries(counts).sort((a, b) => (common.has(a[0]) - common.has(b[0])) || b[1] - a[1]);
    $('loot').innerHTML = loot.length
      ? loot.map(([w, n]) => `<span class="lc${common.has(w) ? '' : ' rare'}">${esc(w.replace(/_/g, ' '))} <b>×${n}</b></span>`).join('')
      : '<span class="muted">Nothing picked up in the last 24 hours.</span>';

    $('runs').innerHTML = runs.slice(0, 40).map((r) => {
      const res = r.result || '?';
      return `<tr><td class="t">${esc(String(r.start).slice(5, 10))} ${esc(hhmm(r.start))}</td><td>${esc(TASK_NAME[r.task] || r.task)}</td>`
        + `<td><span class="tag r-${esc(res)}"><i></i>${esc(res)}</span>${r.error ? `<div class="err">${esc(r.error)}</div>` : ''}</td>`
        + `<td class="n">${Math.round(r.duration || 0)} s</td><td class="n">${r.chests || ''}</td><td>${esc(String(r.picked || '').replace(/_/g, ' '))}</td></tr>`;
    }).join('') || '<tr><td colspan="6" class="muted">No runs yet.</td></tr>';
    $('foottxt').textContent = `Updated ${when(now)} · refreshes every 15 s`;
  }

  async function refresh() {
    if (!token) return showLogin();
    try {
      last = await api('state');
      $('login').hidden = true; $('main').hidden = false; $('foot').hidden = false;
      paint(last);
    } catch (e) {
      if (e.message !== '401') { $('foot').hidden = false; $('foottxt').textContent = `Couldn't reach the site: ${e.message}`; }
    }
  }
  refresh();
  setInterval(() => { if (token && !document.hidden) refresh(); }, 15000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden && token) refresh(); });
})();
</script>
</Base>
