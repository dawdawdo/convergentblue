---
// /bot/: Blizzaga's Armory (everything the D2R characters and shared stash hold, the Chronicle, cube recipes, goals)
// plus a Bot tab: the remote console and loot log for Stephen's D2R bot (worker/bot.js; owner password = DASH_TOKEN,
// kept in this browser's localStorage; anyone can watch, only the owner's controls work).
// Ported from the claude.ai artifact by d2r-bot/armory/to_site.py; this file is now the template (GOALS, FARMS,
// WANT, MOVES, DITCH live in the script). Data: /api/bot/armory, uploaded by GLaDOS (worker/bot.js).
import Base from '../../layouts/Base.astro';
import Spiral from '../../components/Spiral.astro';
---
<Base title="Blizzaga's Armory" description="A Diablo II: Resurrected stash, Chronicle and cube planner, rebuilt from the save files, and the bot that farms it.">
<link slot="head" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600&display=swap" rel="stylesheet" />
<style is:global>

.armory {
  --panel: var(--surface); --raise: var(--code-bg); --line: var(--rule); --fg: var(--ink); --mute: var(--muted);
  /* Always dark: the site's navy band carries down the whole page, and the game's item colors only work on dark.
     Gold (the game's unique-item tan) is structure: titles, rules, selection. The site's blue is action: links, Now. */
  --gold: #c7b377; --gold-dim: #7d6f48; --gold-ink: #15120a;
  --line2: #36415c; --faint: #8590a4;
  --unique: #c7b377; --set: #5fe05c; --rare: #f6f06a; --magic: #9197ff; --rw: #f0a23c; --normal: #f1eee4;
  --ok: #7fd08a; --bad: #ff8a80; --flash: #3d3620;
  --display: 'Cinzel', var(--serif); --body: var(--sans);
  font: 1rem/1.5 var(--sans);
}
:root:has(.armory) {
  --bg: #0a0f1a; --surface: #111828; --ink: #ece8dc; --muted: #a3adbf; --rule: #232d43;
  --brand: #a3abff; --accent-ink: #0b101b; --code-bg: #182135; --band: #060a12;
  color-scheme: dark;
}
main:has(.armory) { background: radial-gradient(70rem 26rem at 50% -8rem, #1b2542 0%, transparent 72%) no-repeat; }

.armory *{box-sizing:border-box}
.armory{-webkit-text-size-adjust:100%}
.armory{background:var(--bg);color:var(--fg);font-family:var(--body);font-size:16px;line-height:1.5}
.armory button,.armory input,.armory select{font:inherit;color:inherit}
.armory .wrap{max-width:1120px;margin:0 auto;padding:0 max(16px,env(safe-area-inset-right,0px)) 64px max(16px,env(safe-area-inset-left,0px))}
.armory .measure{max-width:880px}
.armory a{color:var(--accent)}
.armory :focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.armory [hidden]{display:none!important}
.armory .top{display:flex;flex-wrap:wrap;align-items:center;gap:10px 20px;padding:22px 0 6px}
.armory .top h1{font-family:var(--display);font-weight:700;font-size:clamp(26px,4.4vw,34px);letter-spacing:.03em;line-height:1.1;margin:0;color:var(--accent)}
.armory .top .sub{margin:2px 0 0;color:var(--mute);font-size:15px}
.armory .ahead{flex:1 1 280px;min-width:0}
.armory .fresh{position:relative}
.armory .freshbtn{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line2);background:var(--panel);border-radius:99px;padding:7px 14px;font-size:15px;cursor:pointer;min-height:40px}
.armory .freshbtn .dot{width:10px;height:10px;border-radius:50%;background:var(--ok);flex:none}
.armory .freshbtn.stale .dot{background:transparent;border:2px solid var(--bad)}
.armory .freshbtn.stale b{color:var(--bad)}
.armory .pop{position:absolute;right:0;top:calc(100% + 8px);z-index:40;width:min(360px,calc(100vw - 32px));background:var(--panel);border:1px solid var(--line2);border-radius:12px;padding:14px 16px;box-shadow:0 12px 40px rgb(0 0 0/.25);font-size:15px}
.armory .pop p{margin:0 0 8px}
.armory .pop p:last-child{margin:0}
.armory .pop code{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:14px;background:var(--raise);padding:1px 6px;border-radius:4px}
.armory .bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line);margin:10px 0 22px}
.armory .barin{display:flex;align-items:center;gap:12px}
.armory .tabs{display:flex;gap:2px;overflow-x:auto;flex:1 1 auto;scrollbar-width:none}
.armory .tabs a{display:flex;align-items:baseline;gap:7px;padding:12px 14px 11px;color:var(--mute);text-decoration:none;font-weight:700;font-size:16px;border-bottom:3px solid transparent;white-space:nowrap}
.armory .tabs a:hover{color:var(--fg)}
.armory .tabs a[aria-current="page"]{color:var(--fg);border-color:var(--accent)}
.armory .tabs a small{font-weight:400;font-size:14px;color:var(--faint)}
.armory .find{position:relative;flex:0 1 340px;min-width:0}
.armory .find input{width:100%;height:40px;border:1px solid var(--line2);border-radius:99px;background:var(--panel);padding:0 40px 0 16px;font-size:15px}
.armory .find input:not(:placeholder-shown)~kbd{display:none}
.armory .find kbd{position:absolute;right:12px;top:50%;transform:translateY(-50%);font-family:var(--body);font-size:13px;color:var(--faint);border:1px solid var(--line2);border-radius:5px;padding:0 6px;pointer-events:none}
.armory .results{position:absolute;right:0;top:calc(100% + 6px);width:min(520px,calc(100vw - 32px));max-height:min(70vh,560px);overflow:auto;background:var(--panel);border:1px solid var(--line2);border-radius:12px;box-shadow:0 14px 44px rgb(0 0 0/.28);padding:6px;z-index:45}
.armory .results .rg{font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--faint);padding:10px 10px 4px}
.armory .results button{display:block;width:100%;text-align:left;border:0;background:none;border-radius:8px;padding:8px 10px;cursor:pointer}
.armory .results button[aria-selected="true"],.armory .results button:hover{background:var(--raise)}
.armory .results button span{display:block;font-size:14px;color:var(--mute)}
.armory .results .none{padding:14px 10px;color:var(--mute)}
@media (max-width:700px){.armory .bar{position:static}
.armory .barin{flex-wrap:wrap;gap:8px;padding-bottom:10px}
.armory .find{flex:1 1 100%}
.armory .find kbd{display:none}}
.armory h2{font-family:var(--display);font-weight:700;font-size:20px;letter-spacing:.02em;margin:34px 0 12px;display:flex;align-items:center;gap:14px}
.armory h2::after{content:"";flex:1;height:1px;background:var(--line)}
.armory h2 small{font-family:var(--body);font-weight:400;font-size:15px;color:var(--mute);letter-spacing:0}
.armory section>h2:first-child,.armory .first{margin-top:0}
.armory .lede{color:var(--mute);margin:0 0 14px;max-width:72ch}
.armory .muted{color:var(--mute)}
.armory .faint{color:var(--faint)}
.armory .small{font-size:14px;color:var(--mute)}
.armory .pnl{background:var(--panel);border:1px solid var(--line);border-radius:12px}
.armory .q-Unique{color:var(--unique)}
.armory .q-Set{color:var(--set)}
.armory .q-Rare{color:var(--rare)}
.armory .q-Magic{color:var(--magic)}
.armory .q-RW{color:var(--rw)}
.armory .q-Normal,.armory .q-Superior{color:var(--normal)}
.armory .nm{font-weight:700}
.armory .controls{display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;margin:0 0 18px}
.armory .chips{display:flex;flex-wrap:wrap;gap:6px}
.armory .chip{display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:5px 13px;border-radius:99px;border:1px solid var(--line2);background:var(--panel);cursor:pointer;font-size:15px;white-space:nowrap}
.armory .chip small{font-size:13px;color:var(--faint)}
.armory .chip[aria-pressed="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.armory .chip[aria-pressed="true"] small{color:inherit;opacity:.75}
.armory .seg{display:inline-flex;border:1px solid var(--line2);border-radius:99px;background:var(--panel);padding:3px;gap:2px;flex-wrap:wrap}
.armory .seg button{border:0;background:none;border-radius:99px;padding:6px 14px;min-height:32px;cursor:pointer;font-size:15px;color:var(--mute);white-space:nowrap}
.armory .seg button b{font-weight:700;color:var(--fg)}
.armory .seg button[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink)}
.armory .seg button[aria-pressed="true"] b{color:inherit}
.armory input.filter{height:40px;border:1px solid var(--line2);border-radius:8px;background:var(--panel);padding:0 12px;font-size:15px;flex:1 1 220px;min-width:0}
.armory .tag{display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:700;white-space:nowrap;color:var(--mute)}
.armory .tag i{width:11px;height:11px;border-radius:50%;flex:none;display:inline-block}
.armory .t-now{color:var(--fg)}
.armory .t-now i{background:var(--accent)}
.armory .t-farm i{border:2px solid var(--fg)}
.armory .t-later{color:var(--faint);font-weight:400}
.armory .t-later i{border:2px dashed var(--faint)}
.armory .t-done{color:var(--ok)}
.armory .t-done i{border-radius:0;width:12px;height:7px;border:0;border-left:2.5px solid currentColor;border-bottom:2.5px solid currentColor;transform:rotate(-45deg) translate(1px,-2px)}
.armory .t-move i{border-radius:2px;background:var(--fg);clip-path:polygon(0 15%,60% 15%,60% 0,100% 50%,60% 100%,60% 85%,0 85%)}
.armory .t-ditch{color:var(--bad)}
.armory .t-ditch i{border-radius:0;background:currentColor;clip-path:polygon(20% 0,50% 30%,80% 0,100% 20%,70% 50%,100% 80%,80% 100%,50% 70%,20% 100%,0 80%,30% 50%,0 20%)}
.armory .t-new{color:var(--accent)}
.armory .t-new i{border-radius:0;background:currentColor;clip-path:polygon(50% 0,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)}
.armory .t-worn i{border-radius:2px;background:var(--mute);width:10px;height:10px}
.armory .t-ready{color:var(--ok)}
.armory .t-ready i{background:currentColor}
.armory .t-short{color:var(--mute);font-weight:400}
.armory .t-short i{border:2px solid currentColor}
.armory .runes{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 2px}
.armory .rc{display:inline-flex;align-items:baseline;gap:6px;border:1px solid var(--line2);border-radius:6px;padding:2px 9px;font-size:15px;background:var(--bg)}
.armory .rc b{color:var(--rw)}
.armory .rc.short{border-style:dashed;color:var(--mute)}
.armory .rc.short::after{content:"short";font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:var(--bad);font-weight:700}
.armory .news{padding:16px 18px;margin:0 0 22px;border-color:var(--line2);position:relative}
.armory .news h3{margin:0 0 8px;font-size:17px;display:flex;align-items:center;gap:10px}
.armory .news .row{margin:6px 0 0}
.armory .news .row>b{display:inline-block;min-width:96px;color:var(--mute);font-weight:700}
.armory .news .dismiss{position:absolute;top:12px;right:12px;border:1px solid var(--line2);background:none;border-radius:99px;padding:4px 12px;cursor:pointer;font-size:14px;color:var(--mute)}
.armory .goal{margin:0 0 14px;overflow:hidden}
.armory .goal>summary{list-style:none;cursor:pointer;padding:14px 18px 13px;display:grid;grid-template-columns:1fr auto;gap:2px 16px;align-items:baseline}
.armory .goal>summary::-webkit-details-marker{display:none}
.armory .goal>summary h3{margin:0;font-family:var(--display);font-weight:700;font-size:18px;line-height:1.3;text-wrap:balance}
.armory .goal>summary h3::before{content:"";display:inline-block;width:8px;height:8px;border-right:2px solid var(--faint);border-bottom:2px solid var(--faint);transform:rotate(-45deg);margin:0 12px 2px 0;transition:transform .15s}
.armory .goal[open]>summary h3::before{transform:rotate(45deg)}
.armory .goal .who{grid-column:1;color:var(--mute);font-size:15px;padding-left:22px}
.armory .goal .prog{grid-row:1;grid-column:2;display:flex;align-items:center;gap:10px;font-size:14px;color:var(--mute);font-variant-numeric:tabular-nums}
.armory .meter{display:block;width:72px;height:6px;border-radius:3px;background:var(--raise);overflow:hidden;border:1px solid var(--line)}
.armory .meter i{display:block;height:100%;background:var(--fg)}
.armory .goal .ctx{margin:0 18px 6px 40px;font-size:15px;color:var(--mute)}
.armory .steps{list-style:none;margin:0;padding:0 18px 6px}
.armory .step{display:grid;grid-template-columns:28px 1fr auto;gap:2px 12px;padding:13px 0;border-top:1px solid var(--line);align-items:start}
.armory .step input{width:20px;height:20px;margin:2px 0 0;accent-color:var(--accent);cursor:pointer}
.armory .step .t{font-weight:700;line-height:1.35}
.armory .step .h{color:var(--mute);margin-top:3px}
.armory .step.s-later .t{font-weight:400;color:var(--mute)}
.armory .step.s-done .t{font-weight:400;color:var(--mute);text-decoration:line-through;text-decoration-color:var(--line2)}
.armory .step .tag{margin-top:2px}
.armory .how{margin-top:8px}
.armory .how>summary{cursor:pointer;color:var(--accent);font-weight:700;font-size:15px;width:max-content;list-style:none}
.armory .how>summary::-webkit-details-marker{display:none}
.armory .how>summary::after{content:" ▸"}
.armory .how[open]>summary::after{content:" ▾"}
.armory .how .box{margin-top:8px;padding:10px 14px;background:var(--raise);border-radius:8px;font-size:15px}
.armory .how ul{margin:4px 0 0;padding-left:18px}
.armory .how li{margin:3px 0}
.armory .how .tgt{color:var(--mute);margin:0 0 4px}
.armory .donefold{border-top:1px solid var(--line);margin:0 18px;padding:10px 0 12px}
.armory .donefold>summary{cursor:pointer;color:var(--mute);font-size:15px;list-style:none;width:max-content}
.armory .donefold>summary::-webkit-details-marker{display:none}
.armory .donefold .steps{padding:0}
.armory .tips{padding:12px 16px;margin:0 0 18px;font-size:15px;color:var(--mute)}
.armory .empty{padding:22px;text-align:center;color:var(--mute)}
.armory .plangrid{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:28px;align-items:start}
.armory .planmain{min-width:0;max-width:820px}
.armory .rail{position:sticky;top:76px;display:grid;gap:14px}
.armory .rail .pnl{padding:14px 16px}
.armory .rail h4{margin:0 0 8px;font-size:14px;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}
.armory .rail ul{list-style:none;margin:0;padding:0;display:grid;gap:2px}
.armory .rail li button{display:block;width:100%;text-align:left;border:0;background:none;padding:6px 8px;margin:0 -8px;border-radius:6px;cursor:pointer;width:calc(100% + 16px)}
.armory .rail li button:hover{background:var(--raise)}
.armory .rail li span{display:block;font-size:14px;color:var(--mute)}
.armory .rail .big{font-size:26px;font-weight:700;line-height:1.1}
.armory .rail a{font-weight:700}
@media (max-width:1060px){.armory .plangrid{grid-template-columns:1fr}
.armory .rail{position:static;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}}
.armory .meters{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.armory .mt{padding:16px 18px}
.armory .mt .k{font-size:14px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}
.armory .mt .v{font-size:34px;font-weight:700;line-height:1.1;margin:4px 0 2px;font-variant-numeric:tabular-nums}
.armory .mt .meter{width:100%;height:8px;margin-top:10px}
.armory .mt .d{color:var(--mute);font-size:15px}
.armory .mt .up{color:var(--ok);font-weight:700}
.armory .rwl{display:grid;gap:8px}
.armory .rw>summary{list-style:none;cursor:pointer;padding:12px 16px;display:grid;grid-template-columns:minmax(150px,220px) 1fr auto;gap:4px 16px;align-items:center}
.armory .rw>summary::-webkit-details-marker{display:none}
.armory .rw .nm{color:var(--rw);font-size:17px}
.armory .rw .meta{grid-column:1/3;font-size:14px;color:var(--mute)}
.armory .rw .runes{margin:0}
.armory .rw .body{padding:0 16px 14px;font-size:15px}
.armory .rw .body p{margin:6px 0}
.armory .rw .mods{color:var(--mute)}
.armory .warn{color:var(--bad)}
.armory .star{color:var(--accent);font-weight:700;font-size:14px;margin-left:6px;white-space:nowrap}
.armory .groups{display:grid;gap:8px}
.armory .grp>summary{list-style:none;cursor:pointer;padding:12px 16px;display:flex;gap:10px;align-items:baseline}
.armory .grp>summary::-webkit-details-marker{display:none}
.armory .grp>summary b{font-size:16px}
.armory .grp>summary::before{content:"";width:7px;height:7px;border-right:2px solid var(--faint);border-bottom:2px solid var(--faint);transform:rotate(-45deg);margin-right:4px;flex:none;align-self:center;transition:transform .15s}
.armory .grp[open]>summary::before{transform:rotate(45deg)}
.armory .grp .list{padding:0 16px 14px;display:flex;flex-wrap:wrap;gap:6px}
.armory .mi{border:1px solid var(--line);border-radius:6px;padding:3px 10px;font-size:15px;background:var(--bg)}
.armory .mi span{color:var(--mute);font-size:14px}
.armory .runegrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(70px,1fr));gap:6px}
.armory .rn{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:6px 4px 5px;text-align:center}
.armory .rn b{display:block;font-size:14px;color:var(--rw)}
.armory .rn span{display:block;font-size:20px;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.2}
.armory .rn.zero{background:transparent;border-style:dashed}
.armory .rn.zero b,.armory .rn.zero span{color:var(--faint);font-weight:400}
.armory .ledger2{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;padding:4px 16px 16px}
.armory .ledger2 table{width:100%;border-collapse:collapse;font-size:15px}
.armory .ledger2 th,.armory .ledger2 td{padding:5px 6px;border-bottom:1px solid var(--line);text-align:right;font-variant-numeric:tabular-nums}
.armory .ledger2 th:first-child,.armory .ledger2 td:first-child{text-align:left}
.armory .ledger2 th{font-size:13px;color:var(--mute);font-weight:700}
.armory .ledger2 td.z{color:var(--faint)}
.armory .matg h4{margin:0 0 4px;font-size:14px;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}
.armory .matg{display:grid;gap:12px;align-content:start}
.armory .matg .ml{display:flex;flex-wrap:wrap;gap:4px 16px;font-size:15px}
.armory .matg .ml span b{font-variant-numeric:tabular-nums}
.armory .fold>summary{list-style:none;cursor:pointer;padding:13px 16px;font-weight:700;display:flex;gap:10px;align-items:baseline}
.armory .fold>summary::-webkit-details-marker{display:none}
.armory .fold>summary::before{content:"";width:7px;height:7px;border-right:2px solid var(--faint);border-bottom:2px solid var(--faint);transform:rotate(-45deg);margin-right:4px;flex:none;align-self:center;transition:transform .15s}
.armory .fold[open]>summary::before{transform:rotate(45deg)}
.armory .fold>summary span{font-weight:400;color:var(--mute);font-size:15px}
.armory .hk{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.armory .hk .chip i{width:11px;height:11px}
.armory .ig{margin:0 0 10px}
.armory .ig>summary{list-style:none;cursor:pointer;display:flex;align-items:baseline;gap:10px;padding:13px 16px}
.armory .ig>summary::-webkit-details-marker{display:none}
.armory .ig>summary::before{content:"";width:7px;height:7px;border-right:2px solid var(--faint);border-bottom:2px solid var(--faint);transform:rotate(-45deg);margin-right:4px;flex:none;align-self:center;transition:transform .15s}
.armory .ig[open]>summary::before{transform:rotate(45deg)}
.armory .ig[open]>summary{border-bottom:1px solid var(--line)}
.armory .ig>summary b{font-size:16px}
.armory .it{display:grid;grid-template-columns:minmax(200px,300px) 1fr minmax(120px,auto);gap:4px 18px;padding:11px 16px;border-top:1px solid var(--line);cursor:pointer;align-items:start}
.armory .ig>summary+.it{border-top:0}
.armory .it:hover{background:var(--raise)}
.armory .it .meta{font-size:14px;color:var(--mute);margin-top:1px}
.armory .it .ist{font-size:15px;color:var(--mute);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.armory .it.open .ist{display:block;color:var(--fg)}
.armory .it .st{display:grid;gap:3px;justify-items:start;font-size:14px}
.armory .it .st .pl{color:var(--mute)}
@media (max-width:760px){.armory .it{grid-template-columns:1fr auto}
.armory .it .ist{grid-column:1/-1;grid-row:2}
.armory .rw>summary{grid-template-columns:1fr auto}
.armory .rw .runes{grid-column:1/-1}
.armory .rw .meta{grid-column:1/-1}}
.armory .tbl{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--panel)}
.armory .tbl table{border-collapse:collapse;width:100%;font-size:15px}
