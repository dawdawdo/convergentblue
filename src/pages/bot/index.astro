  RWN.forEach(n => { const s = rwState(n); IDX.push({ k: 'Runewords', t: n, q: 'RW', s: `${s === 'made' ? 'Recorded' : s === 'ready' ? 'Ready to make' : plural(gap(n), 'rune') + ' short'} · ${D.rwdb[n].runes}`, h: (n + ' ' + D.rwdb[n].runes + ' runeword').toLowerCase(), go: () => goRW(n) }); });
  (CH.mug || []).forEach(([n, sl, b]) => IDX.push({ k: 'Not in Chronicle yet', t: n, q: 'Unique', s: `Unique ${sl.toLowerCase().replace(/s$/, '')} · ${b}`, h: (n + ' ' + b + ' unique ' + sl).toLowerCase(), go: () => goMissing(n, 'mulist') }));
  (CH.msg || []).forEach(([n, set]) => IDX.push({ k: 'Not in Chronicle yet', t: n, q: 'Set', s: `Set item · ${set}`, h: (n + ' ' + set + ' set').toLowerCase(), go: () => goMissing(n, 'mslist') }));
  (CH.fug || []).forEach(([n, sl, b]) => IDX.push({ k: 'In Chronicle', t: n, q: 'Unique', s: `Recorded · unique ${sl.toLowerCase().replace(/s$/, '')} · ${b}`, h: (n + ' ' + b + ' unique ' + sl).toLowerCase(), go: () => goRec(n) }));
  (CH.fsg || []).forEach(([n, set]) => IDX.push({ k: 'In Chronicle', t: n, q: 'Set', s: `Recorded · set item · ${set}`, h: (n + ' ' + set + ' set').toLowerCase(), go: () => goRec(n) }));
