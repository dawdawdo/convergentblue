<div class="wide armory">
<header class="top">
  <Spiral class="aspiral" size={270} strokeWidth={2.5} construct />
  <div class="ahead"><h1>Blizzaga's Armory</h1><p class="sub" id="sub"></p></div>
  <div class="fresh">
    <button class="freshbtn" id="freshbtn" aria-expanded="false" aria-controls="freshpop"><span class="dot"></span><span id="freshtxt"></span></button>
