---
import Base from '../layouts/Base.astro';
import PostGrid from '../components/PostGrid.astro';
import PostCard from '../components/PostCard.astro';
import Spiral from '../components/Spiral.astro';
import { getPosts } from '../lib';
const posts = await getPosts();
const featured = posts.find((p) => p.data.demo);
const recent = posts.filter((p) => p !== featured).slice(0, 6);
---
<Base>
  <section class="hero">
    <div class="wide hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Stephen Abrams</p>
        <h1>Things I build.</h1>
        <p class="lede">It's all coming together.</p>
        <p class="hero-links"><a href="/blog/">Read the archive →</a></p>
      </div>
      <Spiral class="hero-spiral" size="100%" animate />
    </div>
  </section>

  <div class="wide">
    {featured && (
      <section class="home-section">
        <div class="section-head"><h2>Try it</h2></div>
        <PostCard post={featured} feature />
      </section>
    )}
    <section class="home-section">
      <div class="section-head"><h2>Recent writing</h2><a href="/blog/">All posts →</a></div>
      <PostGrid posts={recent} />
    </section>
  </div>
</Base>
