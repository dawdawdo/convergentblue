---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { getPosts, getProjects } from '../lib';
const posts = (await getPosts()).slice(0, 5);
const projects = (await getProjects()).slice(0, 4);
---
<Base>
  <div class="wrap">
    <p class="eyebrow">Stephen Abrams</p>
    <h1>Things I build.</h1>
    <p class="lede">It's all coming together.</p>

    <div class="section-head"><h2>Recent writing</h2><a href="/blog/">All posts →</a></div>
    <PostList posts={posts} />

    <div class="section-head"><h2>Projects</h2><a href="/projects/">All projects →</a></div>
    <ProjectCards projects={projects} />
  </div>
</Base>
