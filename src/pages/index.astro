---
import Base from '../layouts/Base.astro';
import PostGrid from '../components/PostGrid.astro';
import PostCard from '../components/PostCard.astro';
import Spiral from '../components/Spiral.astro';
import { getPosts } from '../lib';
const posts = await getPosts();
const featured = posts.find((p) => p.data.demo);
const recent = posts.filter((p) => p !== featured).slice(0, 6);
---
<Base>
  <section class="hero">
    <div class="wide hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Stephen Abrams</p>
        <h1>Things I build.</h1>
        <p class="lede">It's all coming together.</p>
        <p class="hero-links"><a href="/tags/project/">See the projects →</a><a href="/blog/">All writing</a></p>
      </div>
      <Spiral class="hero-spiral" size="100%" animate construct />
    </div>
  </section>

  <div class="wide">
    {featured && (
      <section class="home-section">
        <div class="section-head"><h2>Featured</h2></div>
        <PostCard post={featured} feature />
      </section>
    )}
    <section class="home-section">
      <div class="section-head"><h2>Running now</h2></div>
      <div class="card-grid">
        <article class="card">
          <a class="card-link" href="/bot/" aria-label="Blizzaga's Armory"></a>
          <div class="card-media"><img src="/images/bot/meph-loot.jpg" alt="The bot's view in Mephisto's room: a unique Battle Belt dropped beside the red portal" loading="lazy" decoding="async" /><span class="card-badge">Live</span></div>
          <div class="card-body">
            <span class="meta">Diablo II: Resurrected</span>
            <h3>Blizzaga's Armory</h3>
            <p>A pixel-only bot farming Mephisto and Lower Kurast around the clock, with its live console, loot log, current gear, and the stash, Chronicle and cube planner rebuilt from the save files.</p>
          </div>
        </article>
      </div>
    </section>
    <section class="home-section">
      <div class="section-head"><h2>Recent writing</h2><a href="/blog/">All posts →</a></div>
      <PostGrid posts={recent} />
    </section>
  </div>
</Base>
