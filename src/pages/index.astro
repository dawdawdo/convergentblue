---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib';
const posts = (await getPosts()).slice(0, 5);
---
<Base>
  <div class="wrap">
    <p class="eyebrow">Stephen Abrams</p>
    <h1>Things I build.</h1>
    <p class="lede">It's all coming together.</p>

    <div class="section-head"><h2>Recent writing</h2><a href="/blog/">All posts →</a></div>
    <PostList posts={posts} />

    <p style="margin-top:1.5rem"><a href="/tags/project/">Things I've built →</a></p>
  </div>
</Base>
