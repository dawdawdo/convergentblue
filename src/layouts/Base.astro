---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR } from '../consts';
import Spiral from '../components/Spiral.astro';

// image: social preview (og:image). progress: the header spiral draws itself as the page scrolls (posts).
interface Props { title?: string; description?: string; noindex?: boolean; image?: string; progress?: boolean; }
const { title, description = SITE_DESCRIPTION, noindex = false, image, progress = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/bot/', label: 'D2R Bot' },
  { href: '/blog/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <slot name="head" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap" rel="stylesheet" />
    {progress && (
      <style is:inline>
        /* reading progress: kept inline so the CSS minifier can't merge these two declarations (see global.css) */
        @supports (animation-timeline: scroll()) {
          .spiral-track { opacity: 0.3; }
          .spiral-progress { stroke-dasharray: 1; stroke-dashoffset: 1; animation: spiral-draw linear both; animation-timeline: scroll(root); }
        }
      </style>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wide">
        <a class="brand" href="/"><Spiral class="brand-spiral" size={34} strokeWidth={10} progress={progress} /> {SITE_TITLE}</a>
        <nav>
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wide">
        <span>{SITE_DESCRIPTION}<br />© {new Date().getFullYear()} {AUTHOR}</span>
        <span><a href="/tags/project/">Projects</a> · <a href="/blog/">Writing</a> · <a href="/bot/">D2R Bot</a> · <a href="/about/">About</a> · <a href="/rss.xml">RSS</a> · <a href="https://github.com/dawdawdo">GitHub</a></span>
      </div>
    </footer>
  </body>
</html>
