// Cloudflare Workers config: serve the built Astro site as static files.
{
  "name": "convergentblue",            // must match the Worker name in the Cloudflare dashboard
  "compatibility_date": "2026-10-01",
  "workers_dev": false,                // no duplicate copy at *.workers.dev (SEO)
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",  // serve dist/404.html for unknown URLs
    "html_handling": "auto-trailing-slash"
  }
}
